@article{cheng_sharing_2018,
	title = {The sharing economy and digital discrimination: {The} case of {Airbnb}},
	volume = {70},
	issn = {0278-4319},
	shorttitle = {The sharing economy and digital discrimination},
	url = {https://www.sciencedirect.com/science/article/pii/S0278431917305479},
	doi = {10.1016/j.ijhm.2017.11.002},
	abstract = {Digital discrimination has become a buzz word following the recent reports of racial and other discrimination associated with Airbnb. This issue is perceived to pose serious concerns with the rapid growth of the sharing economy. This research derives insights into digital discrimination through the lens of a series of online newspaper comments made in response to an article reporting Airbnb’s new anti-discrimination policy. The data were analysed by using text-mining and co-stakeholder analysis. The visualized network and each stakeholder’s surrounding discourse reveal that digital discrimination contains multiple layers and meaning constructions. This paper provides a starting point for tourism and hospitality researchers to contribute to the thinking around the digital discrimination with the rapid growth of the sharing economy.},
	urldate = {2026-10-22},
	journal = {International Journal of Hospitality Management},
	author = {Cheng, Mingming and Foley, Carmel},
	month = mar,
	year = {2018},
	keywords = {Airbnb, Co-stakeholder analysis, Digital discrimination, News comments, Text mining},
	pages = {95--98},
	file = {ScienceDirect Full Text PDF:/Users/antoliahou/Zotero/storage/4L8QWRVQ/Cheng and Foley - 2018 - The sharing economy and digital discrimination The case of Airbnb.pdf:application/pdf;ScienceDirect Snapshot:/Users/antoliahou/Zotero/storage/IN38TDY7/S0278431917305479.html:text/html},
}

